<Window x:Class="NvidiaGammaReplica.Controls.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD" Height="70" Width="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Focusable="False" IsHitTestVisible="False">
    <Border Background="#CC1E1E1E" CornerRadius="8" BorderBrush="#76B900" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#76B900" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        <Grid Margin="12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="GAMMA ADJUSTER" Foreground="#9A9A9A" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock x:Name="OsdValueText" Text="1.00" Foreground="#E8E8E8" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <ProgressBar x:Name="OsdProgress" Width="100" Height="6" Margin="12,0,0,0"
                             Minimum="0.3" Maximum="2.8" Value="1.00"
                             Background="#333333" Foreground="#76B900" BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>
        </Grid>
    </Border>
</Window>
