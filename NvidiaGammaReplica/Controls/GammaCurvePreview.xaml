<UserControl x:Class="NvidiaGammaReplica.Controls.GammaCurvePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border CornerRadius="4"
            Background="#181818"
            BorderBrush="#333333"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Rectangle x:Name="GradientStrip" Height="14" VerticalAlignment="Top" Margin="1"/>
            <Canvas x:Name="CurveCanvas" Margin="0,16,0,0" Background="Transparent"/>
        </Grid>
    </Border>
</UserControl>
