<Window x:Class="NvidiaGammaReplica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:controls="clr-namespace:NvidiaGammaReplica.Controls"
        Title="Gamma Adjuster"
        Icon="icon.ico"
        Height="660" Width="520"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <controls:TickPositionConverter x:Key="TickPosConverter"/>

        <!-- Palette -->
        <SolidColorBrush x:Key="BgBrush"        Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SurfaceBrush"   Color="#242424"/>
        <SolidColorBrush x:Key="SurfaceHover"   Color="#2E2E2E"/>
        <SolidColorBrush x:Key="BorderBrushSub" Color="#333333"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#E8E8E8"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#9A9A9A"/>
        <SolidColorBrush x:Key="AccentBrush"    Color="#76B900"/>
        <SolidColorBrush x:Key="AccentDim"      Color="#5C9100"/>
        <SolidColorBrush x:Key="RedThumb"       Color="#E06B6B"/>
        <SolidColorBrush x:Key="GreenThumb"     Color="#76B900"/>
        <SolidColorBrush x:Key="BlueThumb"      Color="#6BA8E0"/>

        <!-- Title bar button -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSub}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource TextSecondary}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboToggleTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  TextElement.Foreground="{StaticResource TextPrimary}"/>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider thumb (parametrized via Tag = brush key) -->
        <Style x:Key="GammaThumb" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Outer" Fill="{StaticResource AccentBrush}"/>
                            <Ellipse Width="5" Height="5" Fill="#0A0A0A"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Fill" Value="#8FD400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Master gamma slider (filled track) -->
        <Style x:Key="GammaSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSub}"
                                    BorderThickness="1"
                                    CornerRadius="2"/>
                            <!-- Tick marks at 0.5 / 1.0 / 1.5 / 2.0 (range 0.3..2.8) -->
                            <Canvas IsHitTestVisible="False">
                                <Canvas.Resources>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Width" Value="1"/>
                                        <Setter Property="Height" Value="8"/>
                                        <Setter Property="Fill" Value="{StaticResource BorderBrushSub}"/>
                                    </Style>
                                </Canvas.Resources>
                                <Rectangle Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource TickPosConverter}, ConverterParameter=0.5}"
                                           Canvas.Top="11"/>
                                <Rectangle Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource TickPosConverter}, ConverterParameter=1.0}"
                                           Canvas.Top="11" Fill="{StaticResource AccentDim}" Width="2"/>
                                <Rectangle Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource TickPosConverter}, ConverterParameter=1.5}"
                                           Canvas.Top="11"/>
                                <Rectangle Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource TickPosConverter}, ConverterParameter=2.0}"
                                           Canvas.Top="11"/>
                            </Canvas>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource AccentBrush}"
                                                        Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GammaThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bipolar slider (centered zero, no fill) for offsets/brightness/contrast -->
        <Style x:Key="BipolarSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSub}"
                                    BorderThickness="1"
                                    CornerRadius="2"/>
                            <!-- center tick -->
                            <Rectangle Width="2" Height="10" Fill="{StaticResource BorderBrushSub}" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GammaThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent button (Set to Max / Reset) -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0A0A0A"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8FD400"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle button (presets, save) -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSub}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Editable numeric value (looks like a label until focused) -->
        <Style x:Key="NumericInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrushSub}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterValueInput" TargetType="TextBox" BasedOn="{StaticResource NumericInput}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="44"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrushSub}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="32" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Rectangle Width="3" Height="14" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"/>
                    <TextBlock Text="GAMMA ADJUSTER"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Padding="0,1,0,0"
                               TextOptions.TextRenderingMode="ClearType"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Hide to tray"/>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="22,4,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Heading -->
                <StackPanel Grid.Row="0" Margin="0,4,0,14">
                    <TextBlock Text="Adjust Desktop Color Settings"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Tune master gamma, per-channel balance, and brightness/contrast."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Monitor selector -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="DISPLAY" Margin="0,0,0,5"/>
                    <ComboBox x:Name="MonitorComboBox"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="MonitorComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- Presets row -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="PRESETS"/>
                        <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                   Text="Right-click a preset to overwrite with current settings"/>
                    </Grid>
                    <UniformGrid Rows="1" Columns="4" HorizontalAlignment="Stretch">
                        <Button x:Name="PresetDayButton" Style="{StaticResource SubtleButton}" Content="Day"
                                Margin="0,0,4,0" Click="PresetButton_Click" MouseRightButtonUp="PresetButton_RightClick" Tag="Day"/>
                        <Button x:Name="PresetNightButton" Style="{StaticResource SubtleButton}" Content="Night"
                                Margin="2,0,2,0" Click="PresetButton_Click" MouseRightButtonUp="PresetButton_RightClick" Tag="Night"/>
                        <Button x:Name="PresetGamingButton" Style="{StaticResource SubtleButton}" Content="Gaming"
                                Margin="2,0,2,0" Click="PresetButton_Click" MouseRightButtonUp="PresetButton_RightClick" Tag="Gaming"/>
                        <Button x:Name="PresetMovieButton" Style="{StaticResource SubtleButton}" Content="Movie"
                                Margin="4,0,0,0" Click="PresetButton_Click" MouseRightButtonUp="PresetButton_RightClick" Tag="Movie"/>
                    </UniformGrid>
                </StackPanel>

                <!-- Master gamma -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="GAMMA" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="GammaValueText" Style="{StaticResource MasterValueInput}" Text="1.00"
                                 Tag="Gamma"
                                 KeyDown="ValueInput_KeyDown" LostFocus="ValueInput_LostFocus"
                                 RenderTransformOrigin="0.5,0.5">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TextBox.RenderTransform>
                        </TextBox>
                    </Grid>
                    <Slider x:Name="GammaSlider"
                            Style="{StaticResource GammaSliderStyle}"
                            Minimum="0.3" Maximum="2.8" Value="1.0"
                            IsMoveToPointEnabled="True"
                            ValueChanged="GammaSlider_ValueChanged"/>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="0.30" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="2.80" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- R/G/B offsets -->
                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="CHANNEL BALANCE" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R" Foreground="{StaticResource RedThumb}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="RedSlider" Style="{StaticResource BipolarSliderStyle}"
                                Minimum="-0.5" Maximum="0.5" Value="0" IsMoveToPointEnabled="True"
                                ValueChanged="ChannelSlider_ValueChanged"/>
                        <TextBox Grid.Column="2" x:Name="RedValueText" Style="{StaticResource NumericInput}"
                                 Text="+0.00" Tag="Red"
                                 KeyDown="ValueInput_KeyDown" LostFocus="ValueInput_LostFocus"
                                 RenderTransformOrigin="0.5,0.5">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TextBox.RenderTransform>
                        </TextBox>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="G" Foreground="{StaticResource GreenThumb}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="GreenSlider" Style="{StaticResource BipolarSliderStyle}"
                                Minimum="-0.5" Maximum="0.5" Value="0" IsMoveToPointEnabled="True"
                                ValueChanged="ChannelSlider_ValueChanged"/>
                        <TextBox Grid.Column="2" x:Name="GreenValueText" Style="{StaticResource NumericInput}"
                                 Text="+0.00" Tag="Green"
                                 KeyDown="ValueInput_KeyDown" LostFocus="ValueInput_LostFocus"
                                 RenderTransformOrigin="0.5,0.5">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TextBox.RenderTransform>
                        </TextBox>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="B" Foreground="{StaticResource BlueThumb}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="BlueSlider" Style="{StaticResource BipolarSliderStyle}"
                                Minimum="-0.5" Maximum="0.5" Value="0" IsMoveToPointEnabled="True"
                                ValueChanged="ChannelSlider_ValueChanged"/>
                        <TextBox Grid.Column="2" x:Name="BlueValueText" Style="{StaticResource NumericInput}"
                                 Text="+0.00" Tag="Blue"
                                 KeyDown="ValueInput_KeyDown" LostFocus="ValueInput_LostFocus"
                                 RenderTransformOrigin="0.5,0.5">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TextBox.RenderTransform>
                        </TextBox>
                    </Grid>
                </StackPanel>

                <!-- Brightness/Contrast -->
                <StackPanel Grid.Row="5" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="BRIGHTNESS / CONTRAST" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Brightness" Foreground="{StaticResource TextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="BrightnessSlider" Style="{StaticResource BipolarSliderStyle}"
                                Minimum="-0.5" Maximum="0.5" Value="0" IsMoveToPointEnabled="True"
                                ValueChanged="ChannelSlider_ValueChanged"/>
                        <TextBox Grid.Column="2" x:Name="BrightnessValueText" Style="{StaticResource NumericInput}"
                                 Text="+0.00" Tag="Brightness"
                                 KeyDown="ValueInput_KeyDown" LostFocus="ValueInput_LostFocus"
                                 RenderTransformOrigin="0.5,0.5">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TextBox.RenderTransform>
                        </TextBox>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Contrast" Foreground="{StaticResource TextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="ContrastSlider" Style="{StaticResource BipolarSliderStyle}"
                                Minimum="-0.5" Maximum="0.5" Value="0" IsMoveToPointEnabled="True"
                                ValueChanged="ChannelSlider_ValueChanged"/>
                        <TextBox Grid.Column="2" x:Name="ContrastValueText" Style="{StaticResource NumericInput}"
                                 Text="+0.00" Tag="Contrast"
                                 KeyDown="ValueInput_KeyDown" LostFocus="ValueInput_LostFocus"
                                 RenderTransformOrigin="0.5,0.5">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TextBox.RenderTransform>
                        </TextBox>
                    </Grid>
                </StackPanel>

                <!-- Curve preview -->
                <StackPanel Grid.Row="6" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="PREVIEW" Margin="0,0,0,5"/>
                    <controls:GammaCurvePreview x:Name="CurvePreview" Height="64"/>
                </StackPanel>

                <!-- Footer -->
                <Grid Grid.Row="7" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SubtleButton}"
                            Content="Set to Max"
                            Click="MaxButton_Click"/>
                    <Button Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource AccentButton}"
                            Content="Reset to Default"
                            Click="ResetButton_Click"/>
                </Grid>
            </Grid>

            <!-- Tray icon -->
            <tb:TaskbarIcon Grid.Row="0" Grid.RowSpan="2"
                            x:Name="TrayIcon"
                            IconSource="icon.ico"
                            ToolTipText="Gamma Adjuster"
                            TrayLeftMouseUp="TrayIcon_LeftClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show" Click="TrayShow_Click"/>
                        <MenuItem Header="Reset All Monitors" Click="TrayResetAll_Click"/>
                        <Separator/>
                        <MenuItem x:Name="StartWithWindowsMenuItem"
                                  Header="Start with Windows"
                                  IsCheckable="True"
                                  Click="StartWithWindows_Click"/>
                        <Separator/>
                        <MenuItem Header="Quit" Click="TrayQuit_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Border>
</Window>
